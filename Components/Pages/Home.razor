@page "/"

@inject DatabaseService Database

<PageTitle>Save Database Explorer</PageTitle>

<div class="page">
    <header class="topbar">
        <div class="brand">
            <div class="brand-mark">DB</div>
            <div>
                <div class="brand-title">Save Database Explorer</div>
                <div class="brand-subtitle">SQLCipher / SQLite save viewer</div>
            </div>
        </div>

        <div class="top-actions">
            @if (Database.IsOpen)
            {
                <div class="connection-pill">
                    <span class="status-dot"></span>
                    Connected
                </div>
            }
            else
            {
                <div class="connection-pill offline">
                    <span class="status-dot"></span>
                    No database
                </div>
            }

            @* <button class="btn btn-secondary" @onclick="OpenDatabaseAsync">
                Open database
            </button> *@
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="error-banner">
            <div>
                <strong>Could not open database</strong>
                <span>@_error</span>
            </div>
            <button class="icon-button" @onclick="() => _error = null">×</button>
        </div>
    }

    <main class="workspace">
        <aside class="sidebar">
            <div class="sidebar-section">
                <div class="section-label">DATABASE</div>

                <div class="database-card">
                    <div class="database-icon">▣</div>
                    <div class="database-meta">
                        <div class="database-name">
                            @(_databaseName ?? "No database")
                        </div>
                        <div class="database-path" title="@Database.DatabasePath">
                            @(Database.IsOpen
                                ? Database.DatabasePath
                                : "Open a .db file to begin")
                        </div>
                    </div>
                </div>
            </div>

            <div class="sidebar-section tables-section">
                <div class="section-heading">
                    <div class="section-label">TABLES</div>
                    @if (Database.IsOpen)
                    {
                        <span class="table-count">@Database.Tables.Count</span>
                    }
                </div>

                @if (!Database.IsOpen)
                {
                    <div class="empty-sidebar">
                        <div class="empty-icon">◌</div>
                        <div>Open a database to view its tables.</div>
                    </div>
                }
                else if (Database.Tables.Count == 0)
                {
                    <div class="empty-sidebar">
                        No user tables found.
                    </div>
                }
                else
                {
                    <div class="table-list">
                        @foreach (var table in Database.Tables)
                        {
                            <button class="table-item @(Database.SelectedTable?.Name == table.Name ? "selected" : "")"
                                    @onclick="() => SelectTableAsync(table)">
                                <span class="table-symbol">▦</span>
                                <span class="table-item-name">@table.Name</span>
                                <span class="row-count">@table.RowCount.ToString("N0")</span>
                            </button>
                        }
                    </div>
                }
            </div>

             @if (Database.IsOpen)
            {
                <div class="sidebar-footer">
                    <button class="sidebar-action" @onclick="OpenDatabaseAsync">
                        <span>＋</span>
                        Open another database
                    </button>
                </div>
            }
            
        </aside>

        <section class="content">
            @if (!Database.IsOpen)
            {
                <div class="welcome">
                    <div class="welcome-icon">▤</div>
                    <h2>Explore your save database</h2>
                    <p>
                        Open your encrypted <strong>.db</strong> and browse
                        its schema and table contents without modifying the save.
                    </p>
                    <button class="btn btn-primary btn-large"
                            @onclick="OpenDatabaseAsync">
                        Open .db file
                    </button>
                    <div class="hint">
                        The configured SQLCipher passphrase is applied automatically.
                    </div>
                </div>
            }
            else if (Database.SelectedTable is null)
            {
                <div class="welcome compact">
                    <div class="welcome-icon">▦</div>
                    <h1>Select a table</h1>
                    <p>Choose a table from the left to inspect its columns and data.</p>
                </div>
            }
            else
            {
                <TableViewer Table="Database.SelectedTable"
                             OnReload="ReloadSelectedTableAsync" />
            }
        </section>
    </main>
</div>

@code {
    private string? _error;
    private string? _databaseName;

    protected override async Task OnInitializedAsync()
    {
        await TryOpenDefaultDatabaseAsync();
    }

    private async Task TryOpenDefaultDatabaseAsync()
    {
        try
        {
            if (File.Exists(DatabaseConfiguration.DefaultDatabasePath))
            {
                await Database.OpenAsync(DatabaseConfiguration.DefaultDatabasePath);
                _databaseName = Path.GetFileName(Database.DatabasePath);
            }
        }
        catch (Exception ex)
        {
            _error = ToUserMessage(ex);
        }
    }

    private async Task OpenDatabaseAsync()
    {
        _error = null;

        try
        {
            var result = await FilePicker.Default.PickAsync(new PickOptions
            {
                PickerTitle = "Select an encrypted SQLite database",
                FileTypes = new FilePickerFileType(
                    new Dictionary<DevicePlatform, IEnumerable<string>>
                    {
                        [DevicePlatform.WinUI] =
                            new[] { ".db", ".sqlite", ".sqlite3" }
                    })
            });

            if (result is null)
                return;

            var localPath = await CopyToLocalPathAsync(result);

            await Database.OpenAsync(localPath);
            _databaseName = Path.GetFileName(localPath);
        }
        catch (Exception ex)
        {
            _error = ToUserMessage(ex);
        }
    }

    private static async Task<string> CopyToLocalPathAsync(FileResult result)
    {
        if (!string.IsNullOrWhiteSpace(result.FullPath) &&
            File.Exists(result.FullPath))
        {
            return result.FullPath;
        }

        var destination = Path.Combine(
            FileSystem.CacheDirectory,
            $"{Guid.NewGuid():N}_{result.FileName}");

        await using var source = await result.OpenReadAsync();
        await using var destinationStream = File.Create(destination);

        await source.CopyToAsync(destinationStream);

        return destination;
    }

    private async Task SelectTableAsync(DatabaseTable table)
    {
        _error = null;
        await Database.SelectTableAsync(table);
    }

    private async Task ReloadSelectedTableAsync()
    {
        _error = null;

        try
        {
            await Database.ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ToUserMessage(ex);
        }
    }

    private static string ToUserMessage(Exception ex)
    {
        if (ex is Microsoft.Data.Sqlite.SqliteException)
        {
            return "SQLite could not read the database. Verify that the SQLCipher key and cipher configuration match the save file.";
        }

        return ex.Message;
    }
}
