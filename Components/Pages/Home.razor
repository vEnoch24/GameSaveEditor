@page "/"
@using GameSaveEditor.Models
@using GameSaveEditor.Services
@using GameSaveEditor.Components.Tools

@inject DatabaseService Database
@inject BackupService BackupService
@inject ProfileService Profiles
@inject AppSettingsService Settings

<PageTitle>Save Database Explorer</PageTitle>

<div class="page">
    <!-- Top Bar -->
    <header class="topbar">
        <div class="brand">
            <div class="brand-mark">DB</div>
            <div>
                <div class="brand-title">Save Database Explorer</div>
                <div class="brand-subtitle">Game save database editor</div>
            </div>
        </div>
        <div class="top-actions">
            @if (Database.IsOpen)
            {
                <div class="connection-pill">
                    <span class="status-dot"></span>
                    @Database.ActiveProfile?.Name · Editable
                </div>
            }
            <button class="btn btn-secondary" @onclick="ShowOpenWizard">Open database</button>
        </div>
    </header>

    <!-- Messages -->
    @if (_message is not null)
    {
        <div class="success-banner">
            <span>✓</span>
            @_message
            <button class="icon-button" @onclick="() => _message = null">×</button>
        </div>
    }

    @if (_error is not null)
    {
        <div class="error-banner">
            <div>
                <strong>Database operation failed</strong>
                <span>@_error</span>
            </div>
            <button class="icon-button" @onclick="() => _error = null">×</button>
        </div>
    }

    <!-- Main Workspace -->
    <main class="workspace">
        <!-- Sidebar -->
        <aside class="sidebar">
            <!-- Database Info -->
            <div class="sidebar-section">
                <div class="section-label">DATABASE</div>
                <div class="database-card">
                    <div class="database-icon">▣</div>
                    <div class="database-meta">
                        <div class="database-name">@(_databaseName ?? "No database")</div>
                        <div class="database-path" title="@Database.DatabasePath">
                            @(Database.IsOpen ? Database.DatabasePath : "Open a .db file to begin")
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tables List -->
            <div class="sidebar-section tables-section">
                <div class="section-heading">
                    <div class="section-label">TABLES</div>
                    @if (Database.IsOpen)
                    {
                        <span class="table-count">@Database.Tables.Count</span>
                    }
                </div>

                @if (!Database.IsOpen)
                {
                    <div class="empty-sidebar">Open a database to view its tables.</div>
                }
                else
                {
                    <div class="table-list">
                        @foreach (var t in Database.Tables)
                        {
                            <button class="table-item @(Database.SelectedTable?.Name == t.Name ? "selected" : "")"
                                    @onclick="() => SelectTableAsync(t)">
                                <span class="table-symbol">▦</span>
                                <span class="table-item-name">@t.Name</span>
                                <span class="row-count">@t.RowCount.ToString("N0")</span>
                            </button>
                        }
                    </div>
                }
            </div>

            <!-- Sidebar Actions -->
            <div class="sidebar-footer">
                @if (Database.IsOpen)
                {
                    <button class="sidebar-action" @onclick="ShowOpenWizard">
                        <span>＋</span> Open another database
                    </button>
                }
                
                <button class="sidebar-action" @onclick="() => _showProfiles = true">
                    <span>◈</span> Database profiles
                </button>
                <button class="sidebar-action" @onclick="() => _showSettings = true">
                    <span>⚙</span> Settings
                </button>
                @if (Database.IsOpen)
                {
                    <button class="sidebar-action" @onclick="() => _showBackups = true">
                        <span>↺</span> Backup manager
                    </button>
                    <button class="sidebar-action" @onclick="() => _showQuery = true">
                        <span>⌘</span> Query console
                    </button>
                }
            </div>
        </aside>

        <!-- Content -->
        <section class="content">
            @if (!Database.IsOpen)
            {
                <!-- Welcome Screen -->
                <div class="welcome">
                    <div class="welcome-icon">▤</div>
                    <h2>Explore and edit a save database</h2>
                    <p>
                        Open a game save, identify its format, choose a reusable profile,
                        verify the key, then edit and save safely.
                    </p>
                    <button class="btn btn-primary btn-large" @onclick="ShowOpenWizard">
                        Open database
                    </button>
                    <div class="hint">
                        Profiles remember database locations and encryption configuration.
                        Encryption keys remain in memory only.
                    </div>

                    <!-- Quick Profiles -->
                    <div class="quick-profiles">
                        <div class="section-label">QUICK OPEN</div>
                        @foreach (var p in Profiles.All
                            .Where(x => !string.IsNullOrWhiteSpace(x.DatabasePath))
                            .OrderByDescending(x => x.LastUsedUtc))
                        {
                            <button class="quick-profile" @onclick="() => OpenProfileAsync(p)">
                                <span>◈</span>
                                <div>
                                    <strong>@p.Name</strong>
                                    <small>@p.DatabasePath</small>
                                </div>
                            </button>
                        }
                    </div>
                </div>
            }
            else if (Database.SelectedTable is null)
            {
                <!-- No Table Selected -->
                <div class="welcome compact">
                    <div class="welcome-icon">▦</div>
                    <h1>Select a table</h1>
                    <p>Choose a table from the left.</p>
                </div>
            }
            else
            {
                <!-- Table Viewer -->
                <TableViewer Table="Database.SelectedTable"
                             Database="Database"
                             BackupService="BackupService"
                             OnError="SetError"
                             OnMessage="SetMessage" />
            }
        </section>
    </main>

    <!-- Modals -->
    @if (_showOpenWizard)
    {
        <div class="modal-backdrop">
            <div class="modal-card wizard-modal">
                <div class="modal-header">
                    <div>
                        <div class="eyebrow">OPEN DATABASE</div>
                        <h2>Database setup wizard</h2>
                    </div>
                    <button class="icon-button" @onclick="CloseOpenWizard">×</button>
                </div>
                <OpenDatabaseWizard InitialPath="@_wizardInitialPath"
                                    InitialProfileId="@_wizardInitialProfileId"
                                    OnCancel="CloseOpenWizard"
                                    OnOpened="HandleOpened"
                                    OnError="SetError" />
            </div>
        </div>
    }

    @if (_showBackups)
    {
        <div class="modal-backdrop">
            <div class="modal-card xlarge-modal">
                <div class="modal-header">
                    <div>
                        <div class="eyebrow">TOOLS</div>
                        <h2>Backup manager</h2>
                    </div>
                    <button class="icon-button" @onclick="() => _showBackups = false">×</button>
                </div>
                <BackupManager BackupService="BackupService"
                               DatabasePath="@Database.DatabasePath"
                               OnRestore="RestoreBackupAsync"
                               OnError="SetError" />
            </div>
        </div>
    }

    @if (_showQuery)
    {
        <div class="modal-backdrop">
            <div class="modal-card xlarge-modal">
                <div class="modal-header">
                    <div>
                        <div class="eyebrow">TOOLS</div>
                        <h2>Query console</h2>
                    </div>
                    <button class="icon-button" @onclick="() => _showQuery = false">×</button>
                </div>
                <QueryConsole Database="Database" />
            </div>
        </div>
    }

    @if (_showProfiles)
    {
        <div class="modal-backdrop">
            <div class="modal-card xlarge-modal">
                <div class="modal-header">
                    <div>
                        <div class="eyebrow">CONFIGURATION</div>
                        <h2>Database profiles</h2>
                    </div>
                    <button class="icon-button" @onclick="() => _showProfiles = false">×</button>
                </div>
                <ProfileManager />
            </div>
        </div>
    }

    @if (_showSettings)
    {
        <div class="modal-backdrop">
            <div class="modal-card wide-modal">
                <div class="modal-header">
                    <div>
                        <div class="eyebrow">APPLICATION</div>
                        <h2>Settings</h2>
                    </div>
                    <button class="icon-button" @onclick="() => _showSettings = false">×</button>
                </div>
                <SettingsPanel />
            </div>
        </div>
    }
</div>

@code {
    // ===== State Fields =====
    private string? _error;
    private string? _message;
    private string? _databaseName;
    private string? _wizardInitialPath;
    private string? _wizardInitialProfileId;
    private bool _showOpenWizard;
    private bool _showBackups;
    private bool _showQuery;
    private bool _showProfiles;
    private bool _showSettings;

    // ===== Lifecycle Methods =====
    protected override async Task OnInitializedAsync()
    {
        if (File.Exists(DatabaseConfiguration.DefaultDatabasePath))
        {
            try
            {
                var profile = DatabaseProfile.BuiltIns.First(x => x.Id == "solo-leveling");
                await Database.OpenAsync(
                    DatabaseConfiguration.DefaultDatabasePath,
                    DatabaseConfiguration.DefaultEncryptionKey,
                    profile
                );
                Profiles.SetSessionKey(profile.Id, DatabaseConfiguration.DefaultEncryptionKey);
                _databaseName = Path.GetFileName(Database.DatabasePath);
                Profiles.MarkUsed(profile, Database.DatabasePath);
            }
            catch (Exception ex)
            {
                _error = ToUserMessage(ex);
            }
        }
    }

    // ===== Modal Controls =====
    private void ShowOpenWizard()
    {
        _error = null;
        _wizardInitialPath = null;
        _wizardInitialProfileId = null;
        _showOpenWizard = true;
    }

    private void CloseOpenWizard()
    {
        _showOpenWizard = false;
    }

    // ===== Event Handlers =====
    private Task HandleOpened(string path)
    {
        _databaseName = Path.GetFileName(path);
        _showOpenWizard = false;
        SetMessage($"Opened {Path.GetFileName(path)} successfully.");
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task OpenProfileAsync(DatabaseProfile p)
    {
        _error = null;

        try
        {
            if (string.IsNullOrWhiteSpace(p.DatabasePath) || !File.Exists(p.DatabasePath))
            {
                SetError("The profile's database path does not exist. Edit the profile and choose a valid path.");
                return;
            }

            if (p.UsesPassphrase)
            {
                _wizardInitialPath = p.DatabasePath;
                _wizardInitialProfileId = p.Id;
                _showOpenWizard = true;
                return;
            }

            await Database.OpenAsync(p.DatabasePath, null, p);
            _databaseName = Path.GetFileName(p.DatabasePath);
            SetMessage($"Opened {p.Name}.");
        }
        catch (Exception ex)
        {
            SetError(ToUserMessage(ex));
        }
    }

    private async Task SelectTableAsync(DatabaseTable t)
    {
        try
        {
            _error = null;
            await Database.SelectTableAsync(t);
        }
        catch (Exception ex)
        {
            SetError(ToUserMessage(ex));
        }
    }

    private async Task RestoreBackupAsync(string backupPath)
    {
        try
        {
            var path = Database.DatabasePath;
            var key = Database.ActiveKey;
            var profile = Database.ActiveProfile;

            Database.Close();
            await BackupService.RestoreBackupAsync(backupPath, path);

            await Database.OpenAsync(
                path,
                key,
                profile ?? DatabaseProfile.BuiltIns.First(x => x.Id == "plain")
            );

            _showBackups = false;
            SetMessage($"Restored {Path.GetFileName(backupPath)}.");
        }
        catch (Exception ex)
        {
            SetError(ex.Message);
        }
    }

    // ===== Message Helpers =====
    private void SetError(string m)
    {
        _error = m;
        _message = null;
        InvokeAsync(StateHasChanged);
    }

    private void SetMessage(string m)
    {
        _message = m;
        _error = null;
        InvokeAsync(StateHasChanged);
    }

    // ===== Utility Methods =====
    private static string ToUserMessage(Exception ex)
        => ex is NotSupportedException
            ? ex.Message
            : ex is Microsoft.Data.Sqlite.SqliteException
                ? "SQLite could not read the database with the selected profile/key. Verify the key and encryption format."
                : ex.Message;
}